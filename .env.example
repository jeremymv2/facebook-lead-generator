# Safe development defaults. Never commit a real .env file.
POSTING_ENABLED=false
DRY_RUN=true
POSTING_QUEUE_ENABLED=false
POSTING_QUEUE_POLL_INTERVAL_SECONDS=60

SCAN_INTERVAL_SECONDS=900
LEAD_THRESHOLD=75
SERVICE_AREA="Louisville, Kentucky"
SERVICE_RADIUS_MILES=50
APPROVAL_EXPIRATION_MINUTES=600
CANDIDATE_DUPLICATE_WINDOW_HOURS=72
APPROVAL_LOCAL_PORT=8765
REMOTE_APPROVAL_PORT=8766
POSTING_APPROVAL_MAX_AGE_MINUTES=20
DAILY_POSTING_LIMIT=5
PER_GROUP_DAILY_POSTING_LIMIT=2
BUSINESS_TIMEZONE=America/New_York
SCREENSHOT_RETENTION_DAYS=14
OPERATIONS_LOG_RETENTION_DAYS=14
OPERATIONS_LOG_MAX_BYTES=5000000
DATABASE_BACKUP_RETENTION_DAYS=14
DATABASE_BACKUP_INTERVAL_HOURS=24
# Scheduled cycles exit before any work from 10 PM through 5 AM in BUSINESS_TIMEZONE.
OPERATIONS_QUIET_HOURS_ENABLED=true
OPERATIONS_QUIET_HOURS_START=22:00
OPERATIONS_QUIET_HOURS_END=05:00
OPERATIONS_DEGRADED_CYCLE_LIMIT=2
OPERATIONS_INCOMPLETE_GROUP_RATE_THRESHOLD=0.25
OPERATIONS_MINIMUM_GROUP_POST_YIELD_RATE=0.50
OPERATIONS_HEALTHY_GROUP_POST_YIELD_RATE=0.80
CYCLE_CLASSIFICATION_LIMIT=100

DATA_DIR=data
DATABASE_PATH=data/lead_agent.sqlite3
# Private, automatically verified SQLite backups. Keep this path out of synced/public folders.
DATABASE_BACKUP_DIR=data/backups
SCREENSHOT_DIR=screenshots
GROUPS_CONFIG_PATH=config/groups.yaml
# Keep this profile outside the repository. It contains Facebook session credentials.
FACEBOOK_PROFILE_PATH=~/.jjmiller-lead-agent/facebook-profile
BROWSER_CHANNEL=
BROWSER_HEADLESS=false
FACEBOOK_NAVIGATION_TIMEOUT_SECONDS=30
FACEBOOK_POST_LOAD_TIMEOUT_SECONDS=15
FACEBOOK_SCAN_MAX_WAIT_SECONDS=25
FACEBOOK_SCAN_IDLE_SECONDS=5
FACEBOOK_GROUP_MAX_RETRIES=1
FACEBOOK_GROUP_RETRY_BACKOFF_SECONDS=5
FACEBOOK_GROUP_DELAY_SECONDS=2
FACEBOOK_MAX_SCROLLS=12
FACEBOOK_SCROLL_SETTLE_SECONDS=0.75
MAX_POSTS_PER_GROUP=10
MIN_POST_TEXT_LENGTH=15

AI_PROVIDER=disabled
AI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=
AI_REQUEST_TIMEOUT_SECONDS=30
AI_MAX_POSTS_PER_RUN=20
AI_MAX_INPUT_CHARACTERS=5000
NOTIFICATIONS_ENABLED=false
NOTIFICATION_POLL_INTERVAL_SECONDS=10
# Stable HTTPS URL supplied by a private relay or outbound reverse tunnel.
REMOTE_APPROVAL_BASE_URL=
# Generate locally with: python -c 'import secrets; print(secrets.token_urlsafe(48))'
APPROVAL_SIGNING_KEY=
SMS_PROVIDER=disabled
# Use E.164 format, for example +15025551234.
SMS_RECIPIENT_NUMBER=
SMS_REQUEST_TIMEOUT_SECONDS=15
TELNYX_API_KEY=
TELNYX_FROM_NUMBER=

LOG_LEVEL=INFO
LOG_JSON=true

# Pydantic reads complex values as JSON.
ENABLED_SERVICES=["general_contracting","handyman","kitchen_remodeling","bathroom_remodeling","cabinet_installation","drywall","painting","carpentry","doors","windows","decks","pressure_washing","fencing","flooring","tile","plumbing_fixtures","landscaping","porches","patios","framing","structural_repairs","general_home_repairs","roof_repair","masonry","exterior_repairs","gutters_and_drainage","outdoor_structures","demolition","installations_and_mounting","insulation_and_air_sealing","minor_plumbing_repairs","appliance_installation","electrical_fixtures","ventilation","property_maintenance","cleanup_and_hauling","project_coordination"]
